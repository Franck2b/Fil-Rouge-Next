# Projet Supabase → Project Settings → API Keys
# La « publishable key » (sb_publishable_…) remplace l'ancienne clé anon.
# Elle est conçue pour être exposée au navigateur : c'est la RLS qui protège les données.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"

# URL publique du site, utilisée par les metadata, le sitemap et robots.txt
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
